# AI 错题分析功能配置
# 复制本文件为 .env.local 后再修改

# 必填：模型服务 API Key
EXPO_PUBLIC_AI_API_KEY=your_api_key_here

# 可选：openai | deepseek | claude
# Cloudflare Web 的错题讲解会优先使用已配置的 Worker 代理；该值仍用于其他 AI 功能
EXPO_PUBLIC_AI_PROVIDER=deepseek

# 可选：DeepSeek OpenAI-compatible 代理 base URL
# FastAPI 不可访问时，Web 端会用它润色本地知识库讲解，适合外部演示
# Web 部署默认使用现有 Cloudflare Worker；本地或更换代理时可以覆盖
# EXPO_PUBLIC_DEEPSEEK_PROXY_URL=https://jlpt-ai-proxy.08075921888chenjian.workers.dev

# M0 RAG 错题服务；留空时使用 App 内置的本地知识库回退
# EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# FastAPI 服务端可选模型配置（不要使用 EXPO_PUBLIC_ 前缀存放真实 API Key）
# AI_LLM_BASE_URL=https://api.deepseek.com/v1
# AI_LLM_API_KEY=your_server_side_key
# AI_LLM_MODEL=deepseek-chat

# 可选语义 Embedding；只有显式启用并运行 npm run ai:embeddings 才会外发索引文本
# AI_EMBEDDING_ENABLED=true
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AI_EMBEDDING_API_KEY=your_server_side_key
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_MIN_SCORE=0.35

# 可选受控 Web RAG；仅显式同步白名单 HTML 页面，不抓取 PDF/ZIP/MP3
# AI_WEB_RAG_ENABLED=true
# AI_WEB_RAG_ALLOWED_HOSTS=jlpt.jp,www.jlpt.jp,samplequestions.jlpt.jp,jpf.go.jp,www.jpf.go.jp
# AI_WEB_RAG_TIMEOUT_SECONDS=10
# AI_WEB_RAG_MAX_AGE_HOURS=168
